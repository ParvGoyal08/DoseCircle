# Copy to .env.local for local development against a deployed stack.
# Without VITE_API_URL, development builds use fixtures and the demo runs as an in-browser simulation.
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com
VITE_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_VAPID_PUBLIC_KEY=
